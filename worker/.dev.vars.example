# Copy to .dev.vars for local `wrangler dev` (gitignored). The Sendblue
# webhook still won't reach localhost — deploy + `wrangler tail` for anything
# webhook-related.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SENDBLUE_API_KEY_ID=
SENDBLUE_API_KEY_SECRET=
SENDBLUE_WEBHOOK_SECRET=

OPENAI_API_KEY=

# Shared secret required by POST /send-test. Leave unset to disable the route.
WORKER_ADMIN_TOKEN=

# HMAC key for report-link tokens — must equal the Next.js app's
# LINK_SIGNING_SECRET so links minted by either side verify on /r/:token.
# Leave unset to disable report links.
LINK_SIGNING_SECRET=
