{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homie-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler doesn't minify by default; with the Agents SDK in the bundle the
  // un-minified eval cost shows up directly as cold-start time.
  "minify": true,
  "observability": { "enabled": true },

  // Static assets (the greeting image Sendblue fetches via media_url).
  // Requests matching a file in ./public serve the asset; everything else
  // falls through to the worker script.
  "assets": { "directory": "./public" },

  // No Durable Objects yet — deliberate, see docs/ARCHITECTURE.md. Supabase is
  // the store for this slice; a PATIENT-style DO can be reintroduced later for
  // contextual/session state without touching the Sendblue adapter.

  // nodejs_compat is required by @openai/agents on Workers (node:async_hooks,
  // node:events, node:crypto, node:stream) — see its own troubleshooting guide's
  // "Cloudflare Workers" section, which lists this as a documented requirement.

  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini",
    "SENDBLUE_FROM_NUMBER": "+18722964991",
    "SKIP_SENDBLUE_VERIFY": "0"
  }

  // Secrets (never committed) — set locally in .dev.vars, and in production
  // with `wrangler secret put <NAME>`:
  //   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
  //   SENDBLUE_API_KEY_ID, SENDBLUE_API_KEY_SECRET, SENDBLUE_WEBHOOK_SECRET
  //   VAPI_API_KEY, VAPI_ASSISTANT_ID, VAPI_WEBHOOK_SECRET
  //   OPENAI_API_KEY
  //   WORKER_ADMIN_TOKEN
}
