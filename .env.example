# Copy to .env.local (gitignored). Server-side only — nothing here may ever
# gain a NEXT_PUBLIC_ prefix; several of these unlock special-category
# health data.

# Supabase (project ailysnnwabnrywhurcvu) — service role, bypasses RLS.
SUPABASE_URL=https://ailysnnwabnrywhurcvu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vercel cron auth: set in Vercel env; Vercel then sends it as a bearer
# token to /api/cron/morning automatically.
CRON_SECRET=

# Shared secret the worker presents to POST /api/links.
LINK_API_SECRET=

# HMAC key for report-link tokens. Rotating it invalidates all live links.
LINK_SIGNING_SECRET=

# Where minted report links point (the worker's /r/:token route). Falls
# back to this app's own origin when unset.
REPORT_BASE_URL=

# Sendblue — same account as worker/.dev.vars. Unset = cron runs dry
# (composes previews, sends nothing, writes nothing).
SENDBLUE_API_KEY_ID=
SENDBLUE_API_KEY_SECRET=
SENDBLUE_FROM_NUMBER=

# Shared coordinate for Open-Meteo until users carry a location.
# Defaults to central London when unset.
HOMIE_DEFAULT_LAT=51.5072
HOMIE_DEFAULT_LON=-0.1276

# Cloudflare worker — the web thread's composer round-trips through the
# worker's /chat route (same safety gates as an inbound text). The token
# must equal the worker's WORKER_ADMIN_TOKEN secret.
WORKER_URL=https://homie-worker.cyrillutterodt.workers.dev
WORKER_ADMIN_TOKEN=

# Clerk (set by `clerk init` in .env.local; add the same two to Vercel).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cron note: vercel.json fires at 06:30 UTC (07:30 London in summer, 06:30
# in winter). Vercel cron has no timezone support; the route's own
# quiet-hours guard (08:00–21:59 local) is what actually protects users.
